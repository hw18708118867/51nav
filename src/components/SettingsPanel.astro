---
import { webEngines } from '../data/searchEngines';
import { toneIcon } from '../lib/tones';
---

<div
  data-settings-overlay
  class="fixed inset-0 z-[60] hidden bg-slate-950/60 backdrop-blur-sm"
  aria-hidden="true"
>
</div>

<aside
  data-settings-panel
  class="fixed right-0 top-0 z-[61] hidden h-full w-80 max-w-[85vw] overflow-y-auto border-l border-white/10 bg-slate-900/95 p-5 shadow-2xl backdrop-blur-xl"
  aria-hidden="true"
>
  <div class="flex items-center justify-between">
    <h2 class="text-lg font-bold text-white">Settings</h2>
    <button data-settings-close class="rounded-lg p-2 text-slate-400 hover:bg-white/10 hover:text-white" aria-label="Close">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path d="M6 6l12 12M18 6 6 18" stroke-linecap="round" />
      </svg>
    </button>
  </div>

  <div class="mt-6">
    <h3 class="text-sm font-semibold text-slate-300">Default search engine</h3>
    <div class="mt-2 space-y-2" data-engine-group>
      {
        webEngines.map((e) => (
          <button
            data-engine-pick={e.id}
            class="flex w-full items-center gap-2 rounded-xl border border-white/10 px-3 py-2 text-sm text-slate-300 hover:bg-white/5"
          >
            <span class={`flex h-6 w-6 items-center justify-center rounded-md text-xs font-bold ${toneIcon[e.color]}`}>
              {e.letter}
            </span>
            {e.name}
          </button>
        ))
      }
    </div>
  </div>

  <p class="mt-8 text-xs text-slate-500">
    Preferences are saved locally in your browser.
  </p>
</aside>

<script>
  const overlay = document.querySelector('[data-settings-overlay]');
  const panel = document.querySelector('[data-settings-panel]');
  const open = () => {
    overlay?.classList.remove('hidden');
    panel?.classList.remove('hidden');
    panel?.setAttribute('aria-hidden', 'false');
    syncActive();
  };
  const close = () => {
    overlay?.classList.add('hidden');
    panel?.classList.add('hidden');
    panel?.setAttribute('aria-hidden', 'true');
  };

  document.querySelector('[data-settings-open]')?.addEventListener('click', open);
  document.querySelector('[data-settings-close]')?.addEventListener('click', close);
  overlay?.addEventListener('click', close);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') close();
  });

  function syncActive() {
    const engine = localStorage.getItem('51nav:engine') || 'google';
    document.querySelectorAll('[data-engine-pick]').forEach((b) => {
      b.classList.toggle('border-brand-400', b.getAttribute('data-engine-pick') === engine);
      b.classList.toggle('bg-white/5', b.getAttribute('data-engine-pick') === engine);
    });
  }

  document.querySelectorAll('[data-engine-pick]').forEach((b) => {
    b.addEventListener('click', () => {
      const id = b.getAttribute('data-engine-pick')!;
      localStorage.setItem('51nav:engine', id);
      window.dispatchEvent(new CustomEvent('51nav:engine', { detail: id }));
      syncActive();
    });
  });
</script>
