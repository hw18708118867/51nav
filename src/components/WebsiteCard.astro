---
import type { Website } from '../lib/types';
import { getCategory } from '../data/categories';
import { websiteCategoryMeta } from '../data/websites';
import { icon as brandIcon } from '../lib/icons';
import { toneIcon } from '../lib/tones';
import Icon from './Icon.astro';

interface Props {
  website: Website;
}

const { website } = Astro.props;
const cat = getCategory(website.category);
const meta = websiteCategoryMeta[website.category] ?? { icon: 'globe', tone: 'slate' };
const toneCls = toneIcon[meta.tone];
const brandSvg = brandIcon(website.id);
const hostname = new URL(website.url).hostname;
const faviconUrl = `https://www.google.com/s2/favicons?domain=${hostname}&sz=128`;
---

<article
  class="website-card group relative flex h-full flex-col rounded-xl border border-line bg-[#0d1420] p-4 transition hover:-translate-y-px hover:border-brand-500/30"
  data-name={website.name.toLowerCase()}
  data-description={website.description.toLowerCase()}
  data-category={website.category}
  data-tags={website.tags.join(' ').toLowerCase()}
  data-featured={website.featured ? '1' : '0'}
>
  <a
    href={`/websites/${website.id}`}
    class="absolute inset-0 z-0 rounded-xl"
    aria-label={`View ${website.name}`}
  ></a>

  <button
    type="button"
    data-fav={website.id}
    aria-label={`Save ${website.name} to favorites`}
    aria-pressed="false"
    class="absolute right-3 top-3 z-20 rounded-full p-1.5 text-faint transition hover:bg-surface-2 hover:text-brand-400 is-fav:text-brand-500"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 24 24">
      <path d="M12 21s-7.5-4.6-10-9.2C.4 8.3 2 4.5 5.5 4.5c2 0 3.4 1.2 4.5 2.7C11.1 5.7 12.5 4.5 14.5 4.5 18 4.5 19.6 8.3 22 11.8 19.5 16.4 12 21 12 21Z"></path>
    </svg>
  </button>

  <div class="relative z-10 flex h-full flex-col pointer-events-none">
    <div class="flex items-start gap-3">
      {
        brandSvg ? (
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-surface-2 ring-1 ring-line">
            <span class="h-7 w-7" set:html={brandSvg} />
          </span>
        ) : (
          <span class={`flex h-12 w-12 shrink-0 items-center justify-center rounded-xl ${toneCls}`}>
            <img
              src={faviconUrl}
              alt=""
              width="28"
              height="28"
              class="h-7 w-7 object-contain"
              onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
            />
            <span class="hidden h-7 w-7 items-center justify-center">
              <Icon name={meta.icon} class="h-5 w-5" />
            </span>
          </span>
        )
      }
      <div class="min-w-0 flex-1">
        <h3 class="truncate text-base font-semibold text-ink">{website.name}</h3>
        {
          cat && (
            <span class={`mt-1 inline-flex items-center rounded-md px-1.5 py-0.5 text-[10px] font-semibold ${toneCls}`}>
              {cat.name}
            </span>
          )
        }
      </div>
    </div>

    <p class="mt-3 line-clamp-2 flex-1 text-sm leading-relaxed text-muted">{website.description}</p>

    <div class="mt-4 flex items-center justify-between pt-1">
      {
        cat && (
          <span class="rounded-full border border-line bg-surface px-2.5 py-1 text-xs font-medium text-faint">
            {cat.name}
          </span>
        )
      }
      <Icon
        name="arrow-right"
        class="h-4 w-4 text-brand-400 transition group-hover:translate-x-0.5"
      />
    </div>
  </div>
</article>
