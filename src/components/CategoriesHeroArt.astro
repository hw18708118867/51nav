---
import Icon from './Icon.astro';
---

<div class="relative hidden w-full max-w-[440px] items-center self-end justify-self-end lg:flex">
  <div class="relative h-[230px] w-full">
    <!-- Central browser-style window -->
    <div
      class="absolute inset-x-[10%] inset-y-[8%] overflow-hidden rounded-2xl border border-slate-700/40 bg-[#0d1420]/90 shadow-[0_0_60px_-15px_rgba(59,130,246,0.25)]"
    >
      <div class="p-6">
        <div class="flex items-center gap-2">
          <div class="h-2.5 w-2.5 rounded-full bg-red-500/70"></div>
          <div class="h-2.5 w-2.5 rounded-full bg-amber-500/70"></div>
          <div class="h-2.5 w-2.5 rounded-full bg-emerald-500/70"></div>
        </div>

        <div class="mt-6 space-y-3">
          <div class="h-2 w-3/4 rounded bg-slate-700/50"></div>
          <div class="h-2 w-1/2 rounded bg-slate-700/30"></div>
          <div class="h-2 w-5/6 rounded bg-slate-700/20"></div>
          <div class="h-2 w-2/3 rounded bg-slate-700/20"></div>
        </div>

        <div class="mt-6 rounded-lg border border-slate-700/30 bg-slate-800/30 p-4">
          <div class="h-2 w-1/3 rounded bg-slate-700/40"></div>
          <div class="mt-3 space-y-2">
            <div class="h-1.5 w-full rounded bg-slate-700/20"></div>
            <div class="h-1.5 w-5/6 rounded bg-slate-700/20"></div>
            <div class="h-1.5 w-4/6 rounded bg-slate-700/20"></div>
          </div>
        </div>
      </div>
    </div>

    <!-- Floating category icon tiles -->
    <div
      class="absolute left-[2%] top-[4%] flex h-12 w-12 items-center justify-center rounded-xl border border-brand-400/40 bg-[#0d1420] shadow-[0_0_16px_-4px_rgba(96,165,250,0.5)]"
    >
      <Icon name="layout-grid" class="h-6 w-6 text-brand-400" />
    </div>

    <div
      class="absolute right-[2%] top-[8%] flex h-12 w-12 items-center justify-center rounded-xl border border-cyan-400/40 bg-[#0d1420] shadow-[0_0_16px_-4px_rgba(34,211,238,0.5)]"
    >
      <Icon name="code-2" class="h-6 w-6 text-cyan-400" />
    </div>

    <div
      class="absolute right-[0%] top-[40%] flex h-12 w-12 items-center justify-center rounded-xl border border-violet-400/40 bg-[#0d1420] shadow-[0_0_16px_-4px_rgba(167,139,250,0.5)]"
    >
      <Icon name="book-open" class="h-6 w-6 text-violet-400" />
    </div>

    <div
      class="absolute right-[6%] bottom-[2%] flex h-12 w-12 items-center justify-center rounded-xl border border-emerald-400/40 bg-[#0d1420] shadow-[0_0_16px_-4px_rgba(52,211,153,0.5)]"
    >
      <Icon name="gamepad-2" class="h-6 w-6 text-emerald-400" />
    </div>

    <div
      class="absolute left-[6%] bottom-[8%] flex h-12 w-12 items-center justify-center rounded-xl border border-fuchsia-400/40 bg-[#0d1420] shadow-[0_0_16px_-4px_rgba(232,121,249,0.5)]"
    >
      <Icon name="brain-circuit" class="h-6 w-6 text-fuchsia-400" />
    </div>

    <!-- Decorative accent dots -->
    <div class="absolute left-[20%] top-[20%] h-2 w-2 rounded-full bg-brand-500/30"></div>
    <div class="absolute right-[18%] top-[25%] h-1.5 w-1.5 rounded-full bg-cyan-400/30"></div>
    <div class="absolute left-[30%] bottom-[16%] h-2 w-2 rounded-full bg-violet-400/25"></div>
  </div>
</div>
