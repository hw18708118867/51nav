---
const nav = [
  { label: 'Tools', href: '/tools' },
  { label: 'Websites', href: '/websites' },
  { label: 'Categories', href: '/categories' },
  { label: 'Guides', href: '/guides' },
];

const path = Astro.url.pathname;
function isActive(href: string): boolean {
  return path === href || path.startsWith(href + '/');
}
---

<header class="sticky top-0 z-40 border-b border-line/70 bg-[#0a0e1c]/75 backdrop-blur-xl">
  <div class="container-page flex h-14 items-center gap-3">
    <a href="/" class="flex shrink-0 items-center gap-2 font-bold text-ink">
      <img src="/favicon.svg" alt="" class="h-7 w-7 rounded-lg" />
      <span class="text-base tracking-tight">51<span class="text-brand-400">NAV</span></span>
    </a>

    <nav class="ml-3 hidden items-center gap-1 md:flex">
      {
        nav.map((n) => {
          const active = isActive(n.href);
          return (
            <a
              href={n.href}
              aria-current={active ? 'page' : undefined}
              class={`rounded-lg px-3 py-2 text-sm font-medium transition ${
                active
                  ? 'bg-brand-500/10 text-brand-400'
                  : 'text-muted hover:text-brand-400'
              }`}
            >
              {n.label}
            </a>
          );
        })
      }
    </nav>

    <div class="ml-auto flex items-center gap-1.5">
      <button
        data-search-open
        class="btn-icon"
        aria-label="Search 51NAV"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" stroke-linecap="round" />
        </svg>
      </button>

      <a
        href="/favorites"
        class="btn-pill relative"
        aria-label="Favorites"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M12 21s-7.5-4.6-10-9.2C.4 8.3 2 4.5 5.5 4.5c2 0 3.4 1.2 4.5 2.7C11.1 5.7 12.5 4.5 14.5 4.5 18 4.5 19.6 8.3 22 11.8 19.5 16.4 12 21 12 21Z" stroke-linejoin="round" />
        </svg>
        <span class="hidden text-sm font-medium sm:inline">Favorites</span>
        <span
          data-fav-count
          class="absolute -right-1.5 -top-1.5 hidden min-w-[18px] rounded-full bg-brand-500 px-1 text-center text-[10px] font-semibold text-white"
          style="display:none">0</span
        >
      </a>

      <button
        data-settings-open
        class="btn-icon"
        aria-label="Settings"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="3" />
          <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z" stroke-linejoin="round" />
        </svg>
      </button>

      <button
        data-mobile-menu
        aria-label="Menu"
        class="btn-icon md:hidden"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile nav -->
  <div data-mobile-panel class="hidden border-t border-line px-4 py-2 md:hidden">
    {
      nav.map((n) => {
        const active = isActive(n.href);
        return (
          <a
            href={n.href}
            aria-current={active ? 'page' : undefined}
            class={`block rounded-lg px-3 py-2 text-sm font-medium transition ${
              active
                ? 'bg-brand-500/10 text-brand-400'
                : 'text-muted hover:bg-surface-2 hover:text-brand-400'
            }`}
          >
            {n.label}
          </a>
        );
      })
    }
  </div>

  <script>
    const btn = document.querySelector('[data-mobile-menu]');
    const panel = document.querySelector('[data-mobile-panel]');
    btn?.addEventListener('click', () => {
      panel?.classList.toggle('hidden');
    });
  </script>
</header>
