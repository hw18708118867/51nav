---
import type { Category } from '../lib/types';
import { websiteCategoryMeta } from '../data/websites';
import { toneSolid } from '../lib/tones';
import Icon from './Icon.astro';

interface Props {
  category: Category & { count: number };
}

const { category } = Astro.props;
const meta = websiteCategoryMeta[category.slug] ?? { icon: 'globe', tone: 'slate' };
const iconBg = toneSolid[meta.tone];
---

<a
  href={`/categories/${category.slug}`}
  class="group tile card-hover flex h-full flex-col p-5 transition"
  aria-label={`Browse ${category.name}`}
  data-name={category.name}
  data-tagline={category.tagline}
>
  <div class="flex items-start gap-4">
    <span
      class={`flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl text-white ${iconBg}`}
    >
      <Icon name={meta.icon} class="h-7 w-7" />
    </span>
    <div class="flex flex-col">
      <h3 class="text-lg font-semibold text-ink">{category.name}</h3>
      <p class="mt-0.5 text-sm text-muted">{category.count} websites</p>
    </div>
  </div>

  <p class="mt-4 line-clamp-2 text-sm leading-relaxed text-muted">
    {category.description}
  </p>

  <div class="mt-auto flex items-center justify-end pt-4">
    <Icon
      name="arrow-right"
      class="h-4 w-4 text-brand-400 transition group-hover:translate-x-0.5"
    />
  </div>
</a>
