---
import { categories } from '../data/categories';
---

<nav class="no-scrollbar -mx-4 flex gap-2 overflow-x-auto px-4 py-1" aria-label="Categories">
  <a
    href="/categories"
    class="shrink-0 rounded-full border border-slate-200 px-3 py-1.5 text-sm font-medium text-slate-600 hover:border-brand-300 hover:text-brand-600 dark:border-slate-700 dark:text-slate-300 dark:hover:border-brand-500"
  >
    All
  </a>
  {
    categories.map((c) => (
      <a
        href={`/categories/${c.slug}`}
        class="shrink-0 whitespace-nowrap rounded-full border border-slate-200 px-3 py-1.5 text-sm font-medium text-slate-600 hover:border-brand-300 hover:text-brand-600 dark:border-slate-700 dark:text-slate-300 dark:hover:border-brand-500"
      >
        {c.name}
      </a>
    ))
  }
</nav>
