---
import type { Website } from '../lib/types';
import { getCategory } from '../data/categories';
import { websiteCategoryMeta } from '../data/websites';
import { toneIcon } from '../lib/tones';
import Icon from './Icon.astro';
import WebsiteLogo from './WebsiteLogo.astro';

interface Props {
  website: Website;
}

const { website } = Astro.props;
const cat = getCategory(website.category);
const meta = websiteCategoryMeta[website.category] ?? { icon: 'globe', tone: 'slate' };
const toneCls = toneIcon[meta.tone];
---

<article
  class="group relative flex h-full flex-col rounded-xl border border-line bg-[#0d1420] p-4 transition hover:-translate-y-px hover:border-line-2"
>
  <a
    href={`/websites/${website.id}`}
    class="absolute inset-0 z-0 rounded-xl"
    aria-label={`View ${website.name}`}
  ></a>

  <div class="pointer-events-none relative z-10 flex h-full flex-col">
    <div class="flex items-start justify-between gap-3">
      <WebsiteLogo website={website} size="md" />
      {
        cat && (
          <span class={`inline-flex shrink-0 items-center rounded-full px-2 py-0.5 text-[10px] font-semibold ${toneCls}`}>
            {cat.name}
          </span>
        )
      }
    </div>

    <h3 class="mt-3 text-base font-semibold text-ink">{website.name}</h3>
    <p class="mt-1 line-clamp-2 flex-1 text-sm leading-relaxed text-muted">{website.description}</p>

    <div class="mt-4 flex items-center justify-end">
      <Icon
        name="arrow-right"
        class="h-4 w-4 text-brand-400 transition group-hover:translate-x-0.5"
      />
    </div>
  </div>
</article>
