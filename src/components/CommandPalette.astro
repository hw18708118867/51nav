---
// Global command palette: unified search across websites, tools and guides.
// Opens via any [data-search-open] element, the ⌘K shortcut, or "/".
---

<div
  id="search-modal"
  class="fixed inset-0 z-50 hidden items-start justify-center bg-slate-950/60 p-4 pt-[12vh] backdrop-blur-sm"
  aria-hidden="true"
>
  <div class="w-full max-w-2xl overflow-hidden rounded-2xl border border-white/10 bg-slate-900/95 shadow-2xl backdrop-blur-xl">
    <div class="flex items-center gap-3 border-b border-white/10 px-4">
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" class="text-slate-400">
        <circle cx="11" cy="11" r="7" /><path d="m21 21-4.3-4.3" stroke-linecap="round" />
      </svg>
      <input
        id="search-input"
        type="text"
        placeholder="Search tools, websites & guides..."
        class="w-full bg-transparent py-4 text-base text-white outline-none placeholder:text-slate-500"
        autocomplete="off"
        aria-label="Search"
      />
      <kbd class="hidden rounded border border-white/15 px-2 py-0.5 text-xs text-slate-400 sm:block">⌘K</kbd>
    </div>
    <div id="search-results" class="max-h-[60vh] overflow-y-auto p-2"></div>
    <div class="flex items-center justify-between border-t border-white/10 px-4 py-2 text-xs text-slate-500">
      <span><kbd class="rounded border border-white/15 px-1">↑</kbd> <kbd class="rounded border border-white/15 px-1">↓</kbd> navigate</span>
      <span><kbd class="rounded border border-white/15 px-1">↵</kbd> open · <kbd class="rounded border border-white/15 px-1">esc</kbd> close</span>
    </div>
  </div>
</div>

<script>
  import Fuse from 'fuse.js';

  type IndexItem = {
    type: string;
    title: string;
    description: string;
    url: string;
    category?: string;
  };

  let index: IndexItem[] = [];
  let fuse: Fuse<IndexItem> | null = null;
  let loaded = false;
  let selected = -1;
  let current: IndexItem[] = [];

  const modal = document.getElementById('search-modal')!;
  const input = document.getElementById('search-input') as HTMLInputElement;
  const results = document.getElementById('search-results')!;

  const tagClass: Record<string, string> = {
    Tool: 'bg-brand-500/20 text-brand-300',
    Guide: 'bg-emerald-500/20 text-emerald-300',
    Website: 'bg-slate-500/20 text-slate-300',
    Category: 'bg-amber-500/20 text-amber-300',
  };

  async function ensureIndex() {
    if (loaded) return;
    const res = await fetch('/search-index.json');
    index = (await res.json()) as IndexItem[];
    fuse = new Fuse(index, {
      keys: ['title', 'description', 'tags', 'category'],
      threshold: 0.4,
      ignoreLocation: true,
    });
    loaded = true;
  }

  function open() {
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    modal.setAttribute('aria-hidden', 'false');
    input.value = '';
    results.innerHTML = '';
    selected = -1;
    current = [];
    input.focus();
    ensureIndex();
  }

  function close() {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    modal.setAttribute('aria-hidden', 'true');
  }

  document.addEventListener('click', (e) => {
    const t = (e.target as HTMLElement).closest<HTMLElement>('[data-search-open]');
    if (t) {
      e.preventDefault();
      open();
    }
  });

  document.querySelector('[data-search-close]')?.addEventListener('click', close);
  modal.addEventListener('click', (e) => {
    if (e.target === modal) close();
  });

  document.addEventListener('keydown', (e) => {
    if ((e.key === 'k' || e.key === 'K') && (e.metaKey || e.ctrlKey)) {
      e.preventDefault();
      open();
      return;
    }
    if (e.key === 'Escape') close();
    if (e.key === '/' && !(e.target as HTMLElement).matches('input, textarea')) {
      e.preventDefault();
      open();
    }
  });

  // Hero site-search can prefill the palette with a query.
  window.addEventListener('51nav:open-search', (e: Event) => {
    const detail = (e as CustomEvent).detail as { query?: string } | undefined;
    open();
    if (detail?.query) {
      input.value = detail.query;
      input.dispatchEvent(new Event('input'));
    }
  });

  input.addEventListener('input', () => {
    const q = input.value.trim();
    if (!q || !fuse) {
      results.innerHTML = '';
      current = [];
      selected = -1;
      return;
    }
    current = fuse.search(q).slice(0, 12).map((h) => h.item);
    selected = current.length ? 0 : -1;
    render();
  });

  function render() {
    if (!current.length) {
      results.innerHTML = '<p class="p-4 text-sm text-slate-500">No results. Try another term.</p>';
      return;
    }
    results.innerHTML = current
      .map((item, i) => {
        const cls = tagClass[item.type] ?? tagClass.Website;
        const active = i === selected ? 'bg-white/10 ring-1 ring-white/15' : '';
        return `
        <a href="${item.url}" data-index="${i}" class="block rounded-xl px-4 py-3 transition ${active}">
          <div class="flex items-center justify-between gap-3">
            <span class="font-medium text-white">${item.title}</span>
            <span class="shrink-0 rounded-full px-2 py-0.5 text-xs font-medium ${cls}">${item.type}</span>
          </div>
          <p class="mt-0.5 line-clamp-1 text-sm text-slate-400">${item.description}</p>
        </a>`;
      })
      .join('');
  }

  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') {
      e.preventDefault();
      if (current.length) {
        selected = (selected + 1) % current.length;
        render();
      }
    } else if (e.key === 'ArrowUp') {
      e.preventDefault();
      if (current.length) {
        selected = (selected - 1 + current.length) % current.length;
        render();
      }
    } else if (e.key === 'Enter') {
      if (selected >= 0 && current[selected]) {
        window.location.href = current[selected].url;
      }
    }
  });

  results.addEventListener('mousemove', (e) => {
    const link = (e.target as HTMLElement).closest<HTMLElement>('a[data-index]');
    if (!link) return;
    const i = Number(link.dataset.index);
    if (i !== selected) {
      selected = i;
      render();
    }
  });
</script>
