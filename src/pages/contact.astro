  description="Get in touch with 51NAV by email."
>
  <section class="mx-auto max-w-2xl px-4 py-12 sm:px-6">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white">Contact</h1>
    <p class="mt-2 text-slate-500 dark:text-slate-400">
      Questions, feedback or corrections? Email us at
      <a class="text-brand-600 hover:underline dark:text-brand-400" href="mailto:miraclehuang611@gmail.com"
        >miraclehuang611@gmail.com</a
      > and we'll get back to you.
    </p>
  </section>
</BaseLayout>
