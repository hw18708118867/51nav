---
import BaseLayout from '../components/BaseLayout.astro';
---

<BaseLayout
  title="Contact — 51NAV"
  description="Get in touch with 51NAV, suggest a website, or report an issue."
>
  <section class="mx-auto max-w-2xl px-4 py-12 sm:px-6">
    <h1 class="text-3xl font-bold text-slate-900 dark:text-white">Contact &amp; Submit a Site</h1>
    <p class="mt-2 text-slate-500 dark:text-slate-400">
      Know a great site we're missing? Send it our way. You can also email
      <a class="text-brand-600 hover:underline dark:text-brand-400" href="mailto:hello@51nav.com"
        >hello@51nav.com</a
      >.
    </p>

    <form
      id="contact-form"
      class="mt-8 space-y-4 rounded-2xl border border-slate-200 bg-white p-6 dark:border-slate-800 dark:bg-slate-900"
    >
      <div>
        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300" for="name">Name</label>
        <input
          id="name"
          name="name"
          required
          class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900 outline-none focus:border-brand-500 dark:border-slate-700 dark:bg-slate-950 dark:text-white"
        />
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300" for="email">Email</label>
        <input
          id="email"
          name="email"
          type="email"
          required
          class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900 outline-none focus:border-brand-500 dark:border-slate-700 dark:bg-slate-950 dark:text-white"
        />
      </div>
      <div>
        <label class="block text-sm font-medium text-slate-700 dark:text-slate-300" for="message"
          >Site URL / Message</label
        >
        <textarea
          id="message"
          name="message"
          rows="4"
          required
          class="mt-1 w-full rounded-lg border border-slate-300 bg-white px-3 py-2 text-slate-900 outline-none focus:border-brand-500 dark:border-slate-700 dark:bg-slate-950 dark:text-white"
        ></textarea>
      </div>
      <button
        type="submit"
        class="rounded-lg bg-brand-600 px-5 py-2.5 font-medium text-white hover:opacity-90"
      >
        Send
      </button>
    </form>
  </section>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement;
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const name = (document.getElementById('name') as HTMLInputElement).value;
      const email = (document.getElementById('email') as HTMLInputElement).value;
      const message = (document.getElementById('message') as HTMLTextAreaElement).value;
      const subject = encodeURIComponent(`51NAV submission from ${name}`);
      const body = encodeURIComponent(`${message}\n\nFrom: ${name} <${email}>`);
      window.location.href = `mailto:hello@51nav.com?subject=${subject}&body=${body}`;
    });
  </script>
</BaseLayout>
