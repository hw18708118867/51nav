---
import BaseLayout from '../components/BaseLayout.astro';

const quickLinks = [
  { href: '/', label: 'Home', desc: 'Your internet start page' },
  { href: '/guides/', label: 'Guides', desc: 'JSON, JWT & Base64 how-tos' },
  { href: '/categories/', label: 'Categories', desc: 'Browse by topic' },
  { href: '/websites/', label: 'Websites', desc: '190+ curated sites' },
  { href: '/tools/', label: 'Tools', desc: 'Free online tools' },
];
---

<BaseLayout
  title="Page Not Found — 51NAV"
  description="The page you are looking for does not exist. Explore 51NAV's tools, guides and curated websites instead."
  noindex
>
  <section class="mx-auto max-w-3xl px-4 py-20 text-center sm:px-6">
    <p class="text-6xl font-bold text-brand-400">404</p>
    <h1 class="mt-4 text-3xl font-bold text-ink md:text-4xl">
      Page not found
    </h1>
    <p class="mt-3 text-muted">
      The page you were looking for does not exist or has moved.
    </p>

    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/"
        class="inline-flex h-10 items-center gap-2 rounded-lg bg-brand-600 px-4 text-sm font-medium text-white transition hover:bg-brand-500"
      >
        Back to Home
      </a>
      <a
        href="/categories/"
        class="inline-flex h-10 items-center gap-2 rounded-lg border border-line bg-surface px-4 text-sm font-medium text-ink transition hover:bg-surface-2"
      >
        Browse Categories
      </a>
    </div>

    <ul class="mt-12 grid gap-3 text-left sm:grid-cols-2">
      {
        quickLinks.map((l) => (
          <li>
            <a
              href={l.href}
              class="group block rounded-card border border-line bg-surface p-4 transition hover:border-line-2 hover:bg-surface-2"
            >
              <span class="font-medium text-ink group-hover:text-brand-400">
                {l.label}
              </span>
              <span class="mt-0.5 block text-sm text-muted">{l.desc}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
