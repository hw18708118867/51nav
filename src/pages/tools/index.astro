---
import BaseLayout from '../../components/BaseLayout.astro';
import ToolGrid from '../../components/ToolGrid.astro';
import Icon from '../../components/Icon.astro';
import { allTools, toolCategories, categoryMeta } from '../../data/toolhub';
import { toneIcon } from '../../lib/tones';

const allCategories = [{ name: 'All', count: allTools.length }, ...toolCategories];
---

<BaseLayout
  title="51NAV Tools — Free Online Tools for Dev, Finance, Health & Games"
  description="Free online tools for developers, finance, health and brain games — calculators, converters, formatters and more."
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <!-- Hero -->
    <section class="pt-12 pb-8 md:pt-16 md:pb-10">
      <div class="grid gap-8 lg:grid-cols-2 lg:items-start">
        <!-- Left: intro + search + filters -->
        <div>
          <div class="flex items-center gap-2 text-brand-400">
            <Icon name="wrench" class="h-5 w-5" />
            <span class="text-sm font-semibold">Tools</span>
          </div>
          <h1 class="mt-2 text-4xl font-bold text-ink md:text-5xl">Tools</h1>
          <p class="mt-2 text-lg text-muted">Powerful online tools to make your work easier.</p>
          <p class="mt-1 max-w-2xl text-sm text-faint">
            Developer utilities, finance calculators, health trackers and brain games — all in one place, free and private.
          </p>

          <!-- Search -->
          <div
            id="tools-search-bar"
            class="mt-6 flex h-[50px] max-w-2xl items-center gap-3 rounded-xl border border-slate-700/40 bg-[#0d1420] px-3 transition"
          >
            <Icon name="search" class="h-5 w-5 text-faint" />
            <input
              id="tools-search"
              type="text"
              placeholder="Search tools..."
              class="flex-1 bg-transparent pl-2 text-sm text-ink placeholder:text-faint outline-none"
              autocomplete="off"
            />
            <kbd class="hidden items-center gap-1 rounded-md border border-line bg-surface px-1.5 py-0.5 text-[11px] font-medium text-muted sm:inline-flex">
              <Icon name="command" class="h-3 w-3" />K
            </kbd>
          </div>

          <!-- Domain tabs (vertical groups) -->
          <div class="mt-6 flex gap-2 overflow-x-auto pb-1 no-scrollbar" id="tools-domains">
            <button
              type="button"
              data-domain="all"
              class="domain-tab shrink-0 rounded-full border px-4 py-1.5 text-sm font-medium transition border-transparent bg-brand-600 text-white"
            >
              All
            </button>
            <button
              type="button"
              data-domain="developer"
              class="domain-tab shrink-0 rounded-full border px-4 py-1.5 text-sm font-medium transition border-line bg-transparent text-muted hover:border-line-2 hover:text-ink"
            >
              Developer
            </button>
            <button
              type="button"
              data-domain="finance"
              class="domain-tab shrink-0 rounded-full border px-4 py-1.5 text-sm font-medium transition border-line bg-transparent text-muted hover:border-line-2 hover:text-ink"
            >
              Finance
            </button>
            <button
              type="button"
              data-domain="health"
              class="domain-tab shrink-0 rounded-full border px-4 py-1.5 text-sm font-medium transition border-line bg-transparent text-muted hover:border-line-2 hover:text-ink"
            >
              Health
            </button>
            <button
              type="button"
              data-domain="games"
              class="domain-tab shrink-0 rounded-full border px-4 py-1.5 text-sm font-medium transition border-line bg-transparent text-muted hover:border-line-2 hover:text-ink"
            >
              Games
            </button>
          </div>

          <!-- Category chips -->
          <div class="mt-3 flex gap-2 overflow-x-auto pb-1 no-scrollbar" id="tools-chips">
            {
              allCategories.map((c) => {
                const icon = c.name === 'All' ? 'layout-grid' : (categoryMeta[c.name]?.icon ?? 'wrench');
                return (
                  <button
                    type="button"
                    data-filter={c.name}
                    class={`filter-chip inline-flex shrink-0 items-center gap-1.5 rounded-full border px-3.5 py-1.5 text-sm font-medium transition ${
                      c.name === 'All'
                        ? 'border-transparent bg-brand-600 text-white'
                        : 'border-line bg-transparent text-muted hover:border-line-2 hover:text-ink'
                    }`}
                  >
                    <Icon name={icon} class="h-4 w-4" />
                    <span>{c.name}</span>
                    <span class="ml-0.5 text-xs opacity-70">{c.count}</span>
                  </button>
                );
              })
            }
          </div>
        </div>

        <!-- Right: representative illustration -->
        <div class="relative hidden lg:flex items-center justify-center">
          <div class="relative w-full max-w-[420px] aspect-[4/3]">
            <!-- Main code/tool window -->
            <div class="absolute inset-x-[8%] inset-y-[12%] overflow-hidden rounded-2xl border border-slate-700/40 bg-[#0d1420] shadow-2xl">
              <div class="flex items-center gap-2 border-b border-slate-700/40 px-4 py-3">
                <div class="h-2.5 w-2.5 rounded-full bg-red-500/70"></div>
                <div class="h-2.5 w-2.5 rounded-full bg-amber-500/70"></div>
                <div class="h-2.5 w-2.5 rounded-full bg-emerald-500/70"></div>
              </div>
              <div class="p-6">
                <Icon name="code-2" class="h-12 w-12 text-brand-400" />
                <div class="mt-5 space-y-3">
                  <div class="h-2 w-3/4 rounded bg-slate-700/50"></div>
                  <div class="h-2 w-1/2 rounded bg-slate-700/30"></div>
                  <div class="h-2 w-5/6 rounded bg-slate-700/20"></div>
                  <div class="h-2 w-2/3 rounded bg-slate-700/20"></div>
                </div>
              </div>
            </div>

            <!-- Floating tool icon badges (vertically aligned, inside window) -->
            <div class="absolute right-[10%] top-[14%] bottom-[14%] flex w-12 flex-col items-center justify-between">
              <div class="flex h-12 w-12 items-center justify-center rounded-xl border border-sky-400/40 bg-[#0d1420] shadow-[0_0_12px_-2px_rgba(56,189,248,0.5)]">
                <svg width="1em" height="1em" viewBox="0 0 24 24" class="h-6 w-6 text-sky-400" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.106-3.105c.32-.322.863-.22.983.218a6 6 0 0 1-8.259 7.057l-7.91 7.91a1 1 0 0 1-2.999-3l7.91-7.91a6 6 0 0 1 7.057-8.259c.438.12.54.662.219.984z"/></svg>
              </div>
              <div class="flex h-12 w-12 items-center justify-center rounded-xl border border-cyan-400/40 bg-[#0d1420] shadow-[0_0_12px_-2px_rgba(34,211,238,0.5)]">
                <svg width="1em" height="1em" viewBox="0 0 24 24" class="h-6 w-6 text-cyan-400" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/></svg>
              </div>
              <div class="flex h-12 w-12 items-center justify-center rounded-xl border border-emerald-400/40 bg-[#0d1420] shadow-[0_0_12px_-2px_rgba(52,211,153,0.5)]">
                <svg width="1em" height="1em" viewBox="0 0 24 24" class="h-6 w-6 text-emerald-400" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7l8.7 5l8.7-5M12 22V12"/></svg>
              </div>
            </div>

            <!-- Decorative accent dots -->
            <div class="absolute left-[6%] top-[22%] h-3 w-3 rounded-full bg-brand-500/30"></div>
            <div class="absolute left-[10%] bottom-[28%] h-2 w-2 rounded-full bg-sky-400/30"></div>
            <div class="absolute right-[24%] bottom-[6%] h-2.5 w-2.5 rounded-full bg-emerald-400/25"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Directory -->
    <section class="pb-16">
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-[240px_1fr]">
        <!-- Sidebar -->
        <aside class="hidden lg:block">
          <div class="sticky top-20 space-y-6">
            <div>
              <h2 class="mb-3 flex items-center gap-2 text-sm font-semibold text-ink">
                <Icon name="layout-grid" class="h-4 w-4 text-brand-400" /> Categories
              </h2>
              <nav class="space-y-1" id="tools-sidebar">
                {
                  allCategories.map((c) => {
                    const icon = c.name === 'All' ? 'layout-grid' : (categoryMeta[c.name]?.icon ?? 'wrench');
                    const toneClasses = c.name === 'All'
                      ? 'bg-brand-500/15 text-brand-400 ring-1 ring-brand-400/20'
                      : toneIcon[categoryMeta[c.name]?.tone ?? 'slate'];
                    return (
                      <button
                        type="button"
                        data-filter={c.name}
                        class={`filter-sidebar group w-full flex items-center justify-between rounded-lg px-3 py-2 text-sm transition ${
                          c.name === 'All'
                            ? 'bg-brand-500/10 text-brand-400'
                            : 'text-muted hover:bg-surface'
                        }`}
                      >
                        <span class="flex items-center gap-2.5">
                          <span class={`flex h-7 w-7 shrink-0 items-center justify-center rounded-lg ${toneClasses}`}>
                            <Icon name={icon} class="h-4 w-4" />
                          </span>
                          <span>{c.name}</span>
                        </span>
                        <span class="flex items-center gap-1.5">
                          <span class="text-xs text-faint">{c.count}</span>
                          <Icon name="chevron-right" class="h-3.5 w-3.5 text-faint transition group-hover:translate-x-0.5" />
                        </span>
                      </button>
                    );
                  })
                }
              </nav>
            </div>

            <div class="rounded-xl border border-line bg-[#0d1420] p-4">
              <h3 class="text-sm font-semibold text-ink">51NAV Tools</h3>
              <p class="mt-1 text-xs leading-relaxed text-muted">
                Aggregating free tools from Toolhub, DevTools, Toolbox, MoneyTools, HealthCalcHub &
                Brain Games — 100% private and processed in your browser.
              </p>
              <div class="mt-3 flex flex-col gap-1.5">
                <a
                  href="https://toolhub.51nav.com"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-xs font-medium text-brand-400 transition hover:text-brand-300"
                >
                  Visit Toolhub <Icon name="arrow-right" class="h-3 w-3" />
                </a>
                <a
                  href="https://devtools.51nav.com"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-xs font-medium text-brand-400 transition hover:text-brand-300"
                >
                  Visit DevTools <Icon name="arrow-right" class="h-3 w-3" />
                </a>
                <a
                  href="https://toolbox.51nav.com"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-xs font-medium text-brand-400 transition hover:text-brand-300"
                >
                  Visit Toolbox <Icon name="arrow-right" class="h-3 w-3" />
                </a>
                <a
                  href="https://moneytools.51nav.com"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-xs font-medium text-brand-400 transition hover:text-brand-300"
                >
                  Visit MoneyTools <Icon name="arrow-right" class="h-3 w-3" />
                </a>
                <a
                  href="https://healthcalchub.51nav.com"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-xs font-medium text-brand-400 transition hover:text-brand-300"
                >
                  Visit HealthCalcHub <Icon name="arrow-right" class="h-3 w-3" />
                </a>
                <a
                  href="https://games.51nav.com"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-xs font-medium text-brand-400 transition hover:text-brand-300"
                >
                  Visit Brain Games <Icon name="arrow-right" class="h-3 w-3" />
                </a>
              </div>
            </div>
          </div>
        </aside>

        <!-- Content -->
        <div>
          <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <h2 class="text-xl font-bold text-ink md:text-2xl" id="tools-heading">All Tools</h2>
              <p class="text-sm text-muted">
                <span id="tools-count">{allTools.length}</span> tools available
              </p>
            </div>
            <div class="flex items-center gap-2">
              <label for="tools-sort" class="text-xs text-muted">Sort by</label>
              <select
                id="tools-sort"
                class="h-9 rounded-lg border border-line bg-[#0d1420] px-2.5 text-sm text-ink outline-none focus:border-brand-500/50"
              >
                <option>Popular</option>
                <option value="name">Name (A–Z)</option>
              </select>
            </div>
          </div>

          <ToolGrid tools={allTools} />

          <nav
            id="tools-pagination"
            class="mt-8 hidden items-center justify-center gap-1"
            aria-label="Pagination"
          ></nav>
        </div>
      </div>
    </section>
  </div>

  <!-- Pre-rendered category icon assets (cloned by client JS into chips & sidebar) -->
  <div id="cat-assets" class="hidden" aria-hidden="true">
    {
      allCategories.map((c) => {
        const m = categoryMeta[c.name] ?? { icon: 'wrench', tone: 'slate' };
        const toneCls = c.name === 'All'
          ? 'bg-brand-500/15 text-brand-400 ring-1 ring-brand-400/20'
          : toneIcon[m.tone];
        return (
          <>
            <template data-kind="icon" data-cat={c.name}>
              <Icon name={m.icon} class="h-4 w-4" />
            </template>
            <template data-kind="chip" data-cat={c.name}>
              <span class={`flex h-7 w-7 shrink-0 items-center justify-center rounded-lg ${toneCls}`}>
                <Icon name={m.icon} class="h-4 w-4" />
              </span>
            </template>
          </>
        );
      })
    }
    <template data-kind="icon" data-cat="All">
      <Icon name="layout-grid" class="h-4 w-4" />
    </template>
    <template data-kind="chip" data-cat="All">
      <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-brand-500/15 text-brand-400 ring-1 ring-brand-400/20">
        <Icon name="layout-grid" class="h-4 w-4" />
      </span>
    </template>
  </div>

  <script>
    (() => {
      const grid = document.getElementById('tools-grid');
      const searchInput = document.getElementById('tools-search') as HTMLInputElement | null;
      const countEl = document.getElementById('tools-count');
      const sortSelect = document.getElementById('tools-sort') as HTMLSelectElement | null;
      const pagination = document.getElementById('tools-pagination');
      const chipsContainer = document.getElementById('tools-chips');
      const sidebarNav = document.getElementById('tools-sidebar');
      const headingEl = document.getElementById('tools-heading');
      const domainTabs = Array.from(document.querySelectorAll<HTMLElement>('.domain-tab'));
      const cards = grid ? Array.from(grid.querySelectorAll<HTMLElement>('.tool-card')) : [];

      // Each domain maps to the set of tool sources it contains.
      const domainSources: Record<string, string[] | null> = {
        all: null,
        developer: ['toolhub', 'devtools', 'toolbox'],
        finance: ['finance'],
        health: ['health'],
        games: ['games'],
      };
      const domainLabels: Record<string, string> = {
        all: 'All Tools',
        developer: 'Developer Tools',
        finance: 'Finance Tools',
        health: 'Health Tools',
        games: 'Games',
      };

      const pageSize = 12;
      const state = { q: '', cat: 'All', page: 1, sort: 'popular', domain: 'all' };

      function normalize(s: string) {
        return s.trim().toLowerCase();
      }

      function cardsInDomain() {
        const srcs = domainSources[state.domain];
        if (!srcs) return cards;
        return cards.filter((c) => srcs.includes(c.dataset.source ?? ''));
      }

      function buildCategories(domainCards: HTMLElement[]) {
        const counts = new Map<string, number>();
        domainCards.forEach((c) => {
          const cat = c.dataset.category ?? 'Uncategorized';
          counts.set(cat, (counts.get(cat) || 0) + 1);
        });
        const list = Array.from(counts.entries())
          .map(([name, count]) => ({ name, count }))
          .sort((a, b) => a.name.localeCompare(b.name));
        return [{ name: 'All', count: domainCards.length }, ...list];
      }

      function escapeHtml(s: string) {
        return s
          .replace(/&/g, '&amp;')
          .replace(/</g, '&lt;')
          .replace(/>/g, '&gt;')
          .replace(/"/g, '&quot;');
      }

      // Pre-rendered category icon assets cloned into chips & sidebar at runtime.
      const catAssetsEl = document.getElementById('cat-assets');
      const catAssetMap: Record<string, Record<string, string>> = { icon: {}, chip: {} };
      if (catAssetsEl) {
        catAssetsEl.querySelectorAll('template').forEach((t) => {
          const kind = t.getAttribute('data-kind');
          const cat = t.getAttribute('data-cat');
          if (kind && cat) catAssetMap[kind][cat] = t.innerHTML;
        });
      }
      function getAsset(kind: string, cat: string) {
        return (catAssetMap[kind] && catAssetMap[kind][cat]) || catAssetMap[kind]['All'] || '';
      }
      const CHEVRON =
        '<svg width="1em" height="1em" viewBox="0 0 24 24" class="h-3.5 w-3.5 text-faint transition group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>';

      function chipClass(active: boolean) {
        return `filter-chip inline-flex shrink-0 items-center gap-1.5 rounded-full border px-3.5 py-1.5 text-sm font-medium transition ${
          active
            ? 'border-transparent bg-brand-600 text-white'
            : 'border-line bg-transparent text-muted hover:border-line-2 hover:text-ink'
        }`;
      }

      function sidebarClass(active: boolean) {
        return `filter-sidebar group w-full flex items-center justify-between rounded-lg px-3 py-2 text-sm transition ${
          active ? 'bg-brand-500/10 text-brand-400' : 'text-muted hover:bg-surface'
        }`;
      }

      function renderFilters() {
        const dCards = cardsInDomain();
        const cats = buildCategories(dCards);
        const chipsHtml = cats
          .map(
            (c) =>
              `<button type="button" data-filter="${escapeHtml(c.name)}" class="${chipClass(c.name === state.cat)}">${getAsset('icon', c.name)}<span>${escapeHtml(c.name)}</span><span class="ml-0.5 text-xs opacity-70">${c.count}</span></button>`
          )
          .join('');
        const sidebarHtml = cats
          .map(
            (c) =>
              `<button type="button" data-filter="${escapeHtml(c.name)}" class="${sidebarClass(c.name === state.cat)}"><span class="flex items-center gap-2.5">${getAsset('chip', c.name)}<span>${escapeHtml(c.name)}</span></span><span class="flex items-center gap-1.5"><span class="text-xs text-faint">${c.count}</span>${CHEVRON}</span></button>`
          )
          .join('');
        if (chipsContainer) chipsContainer.innerHTML = chipsHtml;
        if (sidebarNav) sidebarNav.innerHTML = sidebarHtml;

        const triggers = [
          ...(chipsContainer ? chipsContainer.querySelectorAll<HTMLElement>('.filter-chip') : []),
          ...(sidebarNav ? sidebarNav.querySelectorAll<HTMLElement>('.filter-sidebar') : []),
        ];
        triggers.forEach((btn) => {
          btn.addEventListener('click', () => {
            state.cat = btn.dataset.filter ?? 'All';
            state.page = 1;
            renderFilters();
            render();
          });
        });
      }

      function updateDomainActive() {
        domainTabs.forEach((tab) => {
          const active = (tab.dataset.domain ?? 'all') === state.domain;
          tab.className = `domain-tab shrink-0 rounded-full border px-4 py-1.5 text-sm font-medium transition ${
            active
              ? 'border-transparent bg-brand-600 text-white'
              : 'border-line bg-transparent text-muted hover:border-line-2 hover:text-ink'
          }`;
        });
      }

      function updateHeading() {
        if (headingEl) headingEl.textContent = domainLabels[state.domain] ?? 'All Tools';
      }

      function filtered() {
        const q = normalize(state.q);
        const dCards = cardsInDomain();
        return dCards.filter((card) => {
          const name = normalize(card.dataset.name ?? '');
          const desc = normalize(card.dataset.description ?? '');
          const cat = card.dataset.category ?? '';
          const matchesSearch = !q || name.includes(q) || desc.includes(q);
          const matchesCategory = state.cat === 'All' || cat === state.cat;
          return matchesSearch && matchesCategory;
        });
      }

      function renderPagination(totalPages: number) {
        if (!pagination) return;
        if (totalPages <= 1) {
          pagination.classList.add('hidden');
          pagination.innerHTML = '';
          return;
        }
        pagination.classList.remove('hidden');
        const windowSize = 5;
        const start = Math.max(1, Math.min(state.page - 2, totalPages - windowSize + 1));
        const end = Math.min(totalPages, start + windowSize - 1);

        let html = `<button class="pg-btn rounded-lg border border-line bg-surface px-3 py-1.5 text-sm text-muted transition hover:bg-surface-2 disabled:opacity-40" data-page="prev" ${state.page === 1 ? 'disabled' : ''}>←</button>`;
        for (let p = start; p <= end; p++) {
          html += `<button class="pg-btn rounded-lg px-3 py-1.5 text-sm transition ${
            p === state.page
              ? 'bg-brand-600 text-white'
              : 'border border-line bg-surface text-muted hover:bg-surface-2'
          }" data-page="${p}">${p}</button>`;
        }
        html += `<button class="pg-btn rounded-lg border border-line bg-surface px-3 py-1.5 text-sm text-muted transition hover:bg-surface-2 disabled:opacity-40" data-page="next" ${state.page === totalPages ? 'disabled' : ''}>→</button>`;
        pagination.innerHTML = html;

        pagination.querySelectorAll<HTMLButtonElement>('.pg-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            const v = btn.dataset.page;
            if (v === 'prev') state.page = Math.max(1, state.page - 1);
            else if (v === 'next') state.page = Math.min(totalPages, state.page + 1);
            else state.page = Number(v);
            render();
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        });
      }

      function render() {
        let list = filtered();
        if (state.sort === 'name') {
          list = [...list].sort((a, b) =>
            (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '')
          );
        }
        const total = list.length;
        const totalPages = Math.max(1, Math.ceil(total / pageSize));
        if (state.page > totalPages) state.page = totalPages;

        cards.forEach((c) => c.classList.add('hidden'));
        const startIdx = (state.page - 1) * pageSize;
        list.slice(startIdx, startIdx + pageSize).forEach((c) => c.classList.remove('hidden'));

        if (countEl) countEl.textContent = String(total);
        renderPagination(totalPages);
      }

      domainTabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          state.domain = tab.dataset.domain ?? 'all';
          state.cat = 'All';
          state.page = 1;
          updateDomainActive();
          updateHeading();
          renderFilters();
          render();
        });
      });

      searchInput?.addEventListener('input', () => {
        state.q = searchInput.value;
        state.page = 1;
        render();
      });

      sortSelect?.addEventListener('change', () => {
        state.sort = sortSelect.value === 'name' ? 'name' : 'popular';
        render();
      });

      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          const palette = document.getElementById('search-modal');
          if (palette && !palette.classList.contains('hidden')) return;
          searchInput?.focus();
        }
      });

      updateDomainActive();
      updateHeading();
      renderFilters();
      render();
    })();
  </script>
</BaseLayout>
