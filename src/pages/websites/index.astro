---
import BaseLayout from '../../components/BaseLayout.astro';
import WebsiteGrid from '../../components/WebsiteGrid.astro';
import Icon from '../../components/Icon.astro';
import { websites } from '../../data/websites';
import { categories } from '../../data/categories';
import { websiteCategoryMeta } from '../../data/websites';
import { toneIcon } from '../../lib/tones';

const totalWebsites = websites.length;
const categoryCounts = categories.map((c) => ({
  ...c,
  count: websites.filter((w) => w.category === c.slug).length,
}));
---

<BaseLayout
  title="51NAV Websites — Discover Useful Websites & Online Services"
  description="Browse 190+ curated websites for AI, developers, design, productivity, finance, social, media, games and more."
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6">
    <!-- Hero -->
    <section class="pt-12 pb-8 md:pt-16 md:pb-10">
      <div class="grid gap-8 lg:grid-cols-2 lg:items-start">
        <div>
          <div class="flex items-center gap-2 text-brand-400">
            <Icon name="globe" class="h-5 w-5" />
            <span class="text-sm font-semibold">Websites</span>
          </div>
          <h1 class="mt-2 text-4xl font-bold text-ink md:text-5xl">Websites</h1>
          <p class="mt-2 text-lg text-muted">Discover useful websites and online services.</p>
          <p class="mt-1 max-w-2xl text-sm text-faint">
            Find the best tools, platforms and resources for work, learning, development and everyday life.
          </p>

          <!-- Search -->
          <div
            id="websites-search-bar"
            class="mt-6 flex h-[50px] max-w-2xl items-center gap-3 rounded-xl border border-slate-700/40 bg-[#0d1420] px-3 transition"
          >
            <Icon name="search" class="h-5 w-5 text-faint" />
            <input
              id="websites-search"
              type="text"
              placeholder="Search websites..."
              class="flex-1 bg-transparent pl-2 text-sm text-ink placeholder:text-faint outline-none"
              autocomplete="off"
            />
            <kbd class="hidden items-center gap-1 rounded-md border border-line bg-surface px-1.5 py-0.5 text-[11px] font-medium text-muted sm:inline-flex">
              <Icon name="command" class="h-3 w-3" />K
            </kbd>
          </div>

          <!-- Category pills -->
          <div class="mt-6 flex gap-2 overflow-x-auto pb-1 no-scrollbar" id="websites-categories">
            <button
              type="button"
              data-cat="all"
              data-name="All Websites"
              class="cat-chip inline-flex shrink-0 items-center gap-1.5 rounded-full border border-transparent bg-brand-600 px-3.5 py-1.5 text-sm font-medium text-white transition"
            >
              All <span class="text-xs opacity-80">{totalWebsites}</span>
            </button>
            {
              categoryCounts.map((c) => (
                <button
                  type="button"
                  data-cat={c.slug}
                  data-name={c.name}
                  class="cat-chip inline-flex shrink-0 items-center gap-1.5 rounded-full border border-line bg-transparent px-3.5 py-1.5 text-sm font-medium text-muted transition hover:border-line-2 hover:text-ink"
                >
                  {c.name} <span class="text-xs opacity-70">{c.count}</span>
                </button>
              ))
            }
          </div>
        </div>

        <!-- Hero illustration -->
        <div class="relative hidden lg:flex items-center justify-center">
          <div class="relative w-full max-w-[420px] aspect-[4/3]">
            <!-- Browser window -->
            <div class="absolute inset-x-[8%] inset-y-[12%] overflow-hidden rounded-2xl border border-slate-700/40 bg-[#0d1420] shadow-2xl">
              <div class="flex items-center gap-2 border-b border-slate-700/40 px-4 py-3">
                <div class="h-2.5 w-2.5 rounded-full bg-red-500/70"></div>
                <div class="h-2.5 w-2.5 rounded-full bg-amber-500/70"></div>
                <div class="h-2.5 w-2.5 rounded-full bg-emerald-500/70"></div>
              </div>
              <div class="p-6">
                <svg
                  width="48"
                  height="48"
                  viewBox="0 0 24 24"
                  class="h-12 w-12 text-brand-400"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <circle cx="12" cy="12" r="10"></circle>
                  <path d="M2 12h20"></path>
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
                </svg>
                <div class="mt-5 space-y-3">
                  <div class="h-2 w-3/4 rounded bg-slate-700/50"></div>
                  <div class="h-2 w-1/2 rounded bg-slate-700/30"></div>
                  <div class="h-2 w-5/6 rounded bg-slate-700/20"></div>
                  <div class="h-2 w-2/3 rounded bg-slate-700/20"></div>
                </div>
              </div>
            </div>

            <!-- Floating icon badges -->
            <div class="absolute right-[10%] top-[14%] bottom-[14%] flex w-12 flex-col items-center justify-between">
              <div class="flex h-12 w-12 items-center justify-center rounded-xl border border-brand-400/40 bg-[#0d1420] shadow-[0_0_12px_-2px_rgba(96,165,250,0.5)]">
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  class="h-6 w-6 text-brand-400"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                  <path d="M15 3h6v6"></path>
                  <path d="M10 14 21 3"></path>
                </svg>
              </div>
              <div class="flex h-12 w-12 items-center justify-center rounded-xl border border-violet-400/40 bg-[#0d1420] shadow-[0_0_12px_-2px_rgba(167,139,250,0.5)]">
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  class="h-6 w-6 text-violet-400"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
              </div>
              <div class="flex h-12 w-12 items-center justify-center rounded-xl border border-emerald-400/40 bg-[#0d1420] shadow-[0_0_12px_-2px_rgba(52,211,153,0.5)]">
                <svg
                  width="24"
                  height="24"
                  viewBox="0 0 24 24"
                  class="h-6 w-6 text-emerald-400"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                  <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
              </div>
            </div>

            <!-- Decorative dots -->
            <div class="absolute left-[6%] top-[22%] h-3 w-3 rounded-full bg-brand-500/30"></div>
            <div class="absolute left-[10%] bottom-[28%] h-2 w-2 rounded-full bg-violet-400/30"></div>
            <div class="absolute right-[24%] bottom-[6%] h-2.5 w-2.5 rounded-full bg-emerald-400/25"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- Directory -->
    <section class="pb-16">
      <div class="grid grid-cols-1 gap-6 lg:grid-cols-[240px_1fr]">
        <!-- Sidebar -->
        <aside class="hidden lg:block">
          <div class="sticky top-20 space-y-6">
            <div>
              <h2 class="mb-3 flex items-center gap-2 text-sm font-semibold text-ink">
                <Icon name="layout-grid" class="h-4 w-4 text-brand-400" /> Categories
              </h2>
              <nav class="space-y-1" id="websites-sidebar">
                <button
                  type="button"
                  data-cat="all"
                  data-name="All Websites"
                  class="filter-sidebar group w-full flex items-center justify-between rounded-lg bg-brand-500/10 px-3 py-2 text-sm text-brand-400 transition"
                >
                  <span class="flex items-center gap-2.5">
                    <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-lg bg-brand-500/15 text-brand-400 ring-1 ring-brand-400/20">
                      <Icon name="layout-grid" class="h-4 w-4" />
                    </span>
                    <span>All Websites</span>
                  </span>
                  <span class="text-xs text-faint">{totalWebsites}</span>
                </button>
                {
                  categoryCounts.map((c) => {
                    const m = websiteCategoryMeta[c.slug] ?? { icon: 'globe', tone: 'slate' };
                    return (
                      <button
                        type="button"
                        data-cat={c.slug}
                        data-name={c.name}
                        class="filter-sidebar group w-full flex items-center justify-between rounded-lg px-3 py-2 text-sm text-muted transition hover:bg-surface"
                      >
                        <span class="flex items-center gap-2.5">
                          <span class={`flex h-7 w-7 shrink-0 items-center justify-center rounded-lg ${toneIcon[m.tone]}`}>
                            <Icon name={m.icon} class="h-4 w-4" />
                          </span>
                          <span>{c.name}</span>
                        </span>
                        <span class="text-xs text-faint">{c.count}</span>
                      </button>
                    );
                  })
                }
              </nav>
            </div>

            <div class="rounded-xl border border-line bg-[#0d1420] p-4">
              <h3 class="text-sm font-semibold text-ink">51NAV Websites</h3>
              <p class="mt-1 text-xs leading-relaxed text-muted">
                A curated directory of the best websites and online services across {categories.length} categories.
              </p>
              <a
                href="/websites"
                class="mt-3 inline-flex items-center gap-1 text-xs font-medium text-brand-400 transition hover:text-brand-300"
              >
                Explore All Websites <Icon name="arrow-right" class="h-3 w-3" />
              </a>
            </div>
          </div>
        </aside>

        <!-- Main content -->
        <div>
          <div class="mb-5 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <h2 class="section-title">
                <Icon name="layout-grid" class="section-icon" />
                <span id="websites-heading-text">All Websites</span>
              </h2>
              <p class="mt-1 text-sm text-muted">
                <span id="websites-count">{totalWebsites}</span> websites available
              </p>
            </div>
            <div class="flex items-center gap-2">
              <label for="websites-sort" class="text-sm text-muted">Sort by</label>
              <select
                id="websites-sort"
                class="h-9 rounded-lg border border-line bg-[#0d1420] px-3 text-sm text-ink outline-none focus:border-brand-500/50"
              >
                <option value="popular">Popular</option>
                <option value="name">Name</option>
              </select>
            </div>
          </div>

          <WebsiteGrid websites={websites} pageSize={16} />

          <nav
            id="websites-pagination"
            class="mt-8 hidden items-center justify-center gap-1"
            aria-label="Pagination"
          ></nav>
        </div>
      </div>
    </section>
  </div>

  <script>
    (() => {
      const grid = document.getElementById('websites-grid');
      const cards = grid ? Array.from(grid.querySelectorAll<HTMLElement>('.website-card')) : [];
      const searchInput = document.getElementById('websites-search') as HTMLInputElement | null;
      const sortSelect = document.getElementById('websites-sort') as HTMLSelectElement | null;
      const pagination = document.getElementById('websites-pagination');
      const countEl = document.getElementById('websites-count');
      const headingEl = document.getElementById('websites-heading-text');
      const chipButtons = Array.from(document.querySelectorAll<HTMLElement>('.cat-chip'));
      const sidebarButtons = Array.from(document.querySelectorAll<HTMLElement>('.filter-sidebar'));

      const pageSize = Number(grid?.dataset.pageSize ?? 16);
      const urlCat = new URLSearchParams(window.location.search).get('category') ?? 'all';
      const state = { q: '', cat: urlCat, page: 1, sort: 'popular' };

      function normalize(s: string) {
        return s.trim().toLowerCase();
      }

      function filtered() {
        const q = normalize(state.q);
        return cards.filter((c) => {
          const name = normalize(c.dataset.name ?? '');
          const desc = normalize(c.dataset.description ?? '');
          const tags = normalize(c.dataset.tags ?? '');
          const cat = c.dataset.category ?? '';
          const matchesSearch = !q || name.includes(q) || desc.includes(q) || tags.includes(q);
          const matchesCategory = state.cat === 'all' || cat === state.cat;
          return matchesSearch && matchesCategory;
        });
      }

      function chipClass(active: boolean) {
        return `cat-chip inline-flex shrink-0 items-center gap-1.5 rounded-full border px-3.5 py-1.5 text-sm font-medium transition ${
          active
            ? 'border-transparent bg-brand-600 text-white'
            : 'border-line bg-transparent text-muted hover:border-line-2 hover:text-ink'
        }`;
      }

      function sidebarClass(active: boolean) {
        return `filter-sidebar group w-full flex items-center justify-between rounded-lg px-3 py-2 text-sm transition ${
          active ? 'bg-brand-500/10 text-brand-400' : 'text-muted hover:bg-surface'
        }`;
      }

      function updateActive() {
        chipButtons.forEach((btn) => {
          const active = (btn.dataset.cat ?? 'all') === state.cat;
          btn.className = chipClass(active);
        });
        sidebarButtons.forEach((btn) => {
          const active = (btn.dataset.cat ?? 'all') === state.cat;
          btn.className = sidebarClass(active);
        });
        if (headingEl) {
          const activeBtn = [...chipButtons, ...sidebarButtons].find(
            (b) => (b.dataset.cat ?? 'all') === state.cat
          );
          headingEl.textContent = activeBtn?.dataset.name ?? 'All Websites';
        }
      }

      function renderPagination(totalPages: number) {
        if (!pagination) return;
        if (totalPages <= 1) {
          pagination.classList.add('hidden');
          pagination.innerHTML = '';
          return;
        }
        pagination.classList.remove('hidden');
        const windowSize = 5;
        const start = Math.max(1, Math.min(state.page - 2, totalPages - windowSize + 1));
        const end = Math.min(totalPages, start + windowSize - 1);

        let html = `<button class="pg-btn rounded-lg border border-line bg-surface px-3 py-1.5 text-sm text-muted transition hover:bg-surface-2 disabled:opacity-40" data-page="prev" ${state.page === 1 ? 'disabled' : ''}>←</button>`;
        for (let p = start; p <= end; p++) {
          html += `<button class="pg-btn rounded-lg px-3 py-1.5 text-sm transition ${
            p === state.page
              ? 'bg-brand-600 text-white'
              : 'border border-line bg-surface text-muted hover:bg-surface-2'
          }" data-page="${p}">${p}</button>`;
        }
        html += `<button class="pg-btn rounded-lg border border-line bg-surface px-3 py-1.5 text-sm text-muted transition hover:bg-surface-2 disabled:opacity-40" data-page="next" ${state.page === totalPages ? 'disabled' : ''}>→</button>`;
        pagination.innerHTML = html;

        pagination.querySelectorAll<HTMLButtonElement>('.pg-btn').forEach((btn) => {
          btn.addEventListener('click', () => {
            const v = btn.dataset.page;
            if (v === 'prev') state.page = Math.max(1, state.page - 1);
            else if (v === 'next') state.page = Math.min(totalPages, state.page + 1);
            else state.page = Number(v);
            render();
            window.scrollTo({ top: 0, behavior: 'smooth' });
          });
        });
      }

      function render() {
        let list = filtered();
        if (state.sort === 'name') {
          list = [...list].sort((a, b) => (a.dataset.name ?? '').localeCompare(b.dataset.name ?? ''));
        } else {
          list = [...list].sort(
            (a, b) =>
              Number(b.dataset.featured ?? 0) - Number(a.dataset.featured ?? 0) ||
              (a.dataset.name ?? '').localeCompare(b.dataset.name ?? '')
          );
        }
        const total = list.length;
        const totalPages = Math.max(1, Math.ceil(total / pageSize));
        if (state.page > totalPages) state.page = totalPages || 1;

        cards.forEach((c) => c.classList.add('hidden'));
        const startIdx = (state.page - 1) * pageSize;
        list.slice(startIdx, startIdx + pageSize).forEach((c) => c.classList.remove('hidden'));

        if (countEl) countEl.textContent = String(total);
        renderPagination(totalPages);
        updateActive();
      }

      chipButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          state.cat = btn.dataset.cat ?? 'all';
          state.page = 1;
          render();
        });
      });

      sidebarButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          state.cat = btn.dataset.cat ?? 'all';
          state.page = 1;
          render();
        });
      });

      searchInput?.addEventListener('input', () => {
        state.q = searchInput.value;
        state.page = 1;
        render();
      });

      sortSelect?.addEventListener('change', () => {
        state.sort = sortSelect.value === 'name' ? 'name' : 'popular';
        render();
      });

      document.addEventListener('keydown', (e) => {
        if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
          e.preventDefault();
          const palette = document.getElementById('search-modal');
          if (palette && !palette.classList.contains('hidden')) return;
          searchInput?.focus();
        }
      });

      render();
    })();
  </script>
</BaseLayout>
