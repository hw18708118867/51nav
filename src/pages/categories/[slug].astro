---
import BaseLayout from '../../components/BaseLayout.astro';
import WebsiteGrid from '../../components/WebsiteGrid.astro';
import { categories, getCategory } from '../../data/categories';
import { getWebsitesByCategory } from '../../data/websites';
import { myTools } from '../../data/ownSites';

export function getStaticPaths() {
  return categories.map((c) => ({ params: { slug: c.slug } }));
}

const { slug } = Astro.params;
const category = getCategory(slug!)!;
const list = getWebsitesByCategory(slug!);
const related = categories.filter((c) => c.slug !== slug).slice(0, 8);
---

<BaseLayout title={`${category.name} — 51NAV`} description={category.description}>
  <section class="mx-auto max-w-7xl px-4 py-12 sm:px-6">
    <a href="/categories" class="text-sm text-brand-600 hover:underline dark:text-brand-400"
      >← All categories</a
    >
    <h1 class="mt-3 text-3xl font-bold text-slate-900 dark:text-white">{category.name}</h1>
    <p class="mt-2 max-w-2xl text-slate-500 dark:text-slate-400">{category.description}</p>

    <div class="mt-8">
      <h2 class="mb-4 text-lg font-semibold text-slate-900 dark:text-white">
        Websites in {category.name}
        <span class="ml-1 text-sm font-normal text-slate-400">({list.length})</span>
      </h2>
      <WebsiteGrid websites={list} />
    </div>

    <div class="mt-10">
      <h2 class="mb-3 text-lg font-semibold text-slate-900 dark:text-white">Explore more</h2>
      <div class="flex flex-wrap gap-2">
        {
          related.map((c) => (
            <a
              href={`/categories/${c.slug}`}
              class="rounded-full border border-slate-200 px-3 py-1.5 text-sm text-slate-600 hover:border-brand-300 hover:text-brand-600 dark:border-slate-700 dark:text-slate-300 dark:hover:border-brand-500"
            >
              {c.name}
            </a>
          ))
        }
      </div>
    </div>

    <div
      class="mt-10 rounded-2xl border border-slate-200 bg-slate-50 p-6 dark:border-slate-800 dark:bg-slate-900"
    >
      <h2 class="text-lg font-semibold text-slate-900 dark:text-white">51NAV Tools</h2>
      <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">
        Prefer a dedicated tool? Jump to the 51NAV tool network.
      </p>
      <div class="mt-4 flex flex-wrap gap-2">
        {
          myTools.map((t) => (
            <a
              href={t.url}
              target="_blank"
              rel="noopener noreferrer"
              class="rounded-full bg-brand-600 px-3 py-1.5 text-sm text-white hover:opacity-90"
            >
              {t.name}
            </a>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
